{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ENABLE_STOP_REVIEW": "0"
  },
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm ci *)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm run typecheck)",
      "Bash(npm run test)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(go mod tidy)",
      "Bash(go fmt *)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr merge *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(git switch main)",
      "Bash(git pull)"
    ],
    "deny": [
      "Bash(git add -f *)",
      "Bash(git add --force *)"
    ]
  },
  "enabledPlugins": {
    "apps-workflow@n-yoshida-dev": true,
    "security-guidance@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "n-yoshida-dev": {
      "source": {
        "source": "github",
        "repo": "n-yoshida-dev/claude-plugins"
      }
    }
  }
}
