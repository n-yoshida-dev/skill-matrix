{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm ci *)",
      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm run typecheck)",
      "Bash(npm run test)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(go mod tidy)",
      "Bash(go fmt *)",
      "Bash(node --version)",
      "Bash(npm --version)"
    ],
    "deny": [
      "Bash(git add -f *)",
      "Bash(git add --force *)"
    ]
  },

  "extraKnownMarketplaces": {
    "n-yoshida-dev": {
      "source": { "source": "github", "repo": "n-yoshida-dev/claude-plugins" }
    }
  },
  "enabledPlugins": {
    "apps-workflow@n-yoshida-dev": true
  }
}
