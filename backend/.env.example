# backend/.env のひな形。実際の値を入れた .env は絶対にコミットしないこと。
#
# 変数の一覧と意味の正本は SPEC.md §8.3、読み込みと検証は internal/config にある。
# ここに書いてある値はすべて開発用のダミー。本番の値は環境変数として与える。
#
# 使い方（Docker Compose を使わずローカルで起動する場合）:
#   cp backend/.env.example backend/.env
#   set -a; source backend/.env; set +a
#   go -C backend run ./cmd/server
#
# Docker Compose で起動する場合も同じ backend/.env を使う（compose が env_file として読む）:
#   docker compose up -d --build backend
# このとき DATABASE_URL と PORT だけは docker-compose.yml 側の値で上書きされる
# （コンテナの中から見た DB の住所は localhost ではなく postgres になるため）

# --- 実行環境 -----------------------------------------------------------------

# development | production
# development のときだけ Cookie の Secure 属性を落とす（ローカルは http のため）
APP_ENV=development

# サーバの待ち受けポート（未設定なら 8080）
PORT=8080

# フロントエンドのオリジン。CORS の許可と、ログイン後の戻り先に使う
FRONTEND_ORIGIN=http://localhost:5173

# --- データベース -------------------------------------------------------------

# PostgreSQL 接続文字列。docker-compose.yml の postgres サービスに合わせた開発用の値
DATABASE_URL=postgres://skillmatrix:skillmatrix@localhost:5432/skillmatrix?sslmode=disable

# --- 認証 ---------------------------------------------------------------------

# セッション Cookie の署名鍵。32文字以上。開発用でも使い回さないこと
# 生成例: openssl rand -base64 48
SESSION_SECRET=

# GitHub OAuth App の設定
# https://github.com/settings/developers で作成し、Authorization callback URL には
# 下の GITHUB_OAUTH_CALLBACK_URL と同じ値を登録する
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8080/api/auth/github/callback

# --- AI 判定 ------------------------------------------------------------------

# anthropic | stub
# anthropic は実際に Claude API を呼ぶ。1 回の判定ごとに課金される（SPEC.md §4.6 に概算）
# stub は LLM を呼ばず、同じ入力には同じ判定を返す。開発中の課金をゼロにできる
# （ログの本文は読まず、ロードマップの先頭から未達の項目を 3 件まで 1 段ずつ上げる。SPEC.md §4.6）
LLM_PROVIDER=stub

# 学習ログの理解度判定に使う Claude API のキー。フロントエンドには絶対に渡さない
# LLM_PROVIDER=anthropic のときだけ必須
ANTHROPIC_API_KEY=

# 判定に使うモデル。未設定なら claude-sonnet-5。
# 負荷が上がって費用が気になったら claude-haiku-4-5 に落とせる（SPEC.md §4.6）
ANTHROPIC_MODEL=claude-sonnet-5

# 1ユーザーあたりの月間判定回数の上限
JUDGMENT_MONTHLY_QUOTA=100

# この確信度を下回る判定は保留にする（検証ルール V7）
JUDGMENT_CONFIDENCE_THRESHOLD=0.5

# 1件のログで更新を認める項目数の上限（検証ルール V8）
JUDGMENT_MAX_ITEMS_PER_LOG=20

# 1つの判定ジョブを試す回数の上限（1〜10）。
# 再試行するのは一時的な失敗（混雑・通信断・応答待ちの時間切れ）だけ。
# 出力が読み取れない失敗と認証の失敗は、何度やっても同じなので再試行しない
JUDGMENT_MAX_ATTEMPTS=3
